<UserControl x:Class="DQB2NPCViewer.control.CharacterButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2NPCViewer.control"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="330">
    <Grid>
        <Button Name="CharButton"  Click="Button_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="255"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImageToChange" Height="60" Margin="3,3,3,3"/>
                <Grid VerticalAlignment="Center" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                    <Grid Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Source="{Binding Path=NPC.Value.IslandImage, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Image Grid.Column="1" Width="20" Height="20" Source="{Binding Path=NPC.Value.PlaceImage, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                    <TextBlock Grid.Column="0" Grid.Row="1"  FontWeight="Bold" Text="{Binding StringFormat={}{0}, Path=NPC.Value.offset, RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}" VerticalAlignment="Center">
                </TextBlock>
                <TextBlock Grid.Column="1"  Grid.Row="1"  FontWeight="Bold" Text="{Binding StringFormat=NAME: {0}, Path=NPC.Value.name, RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}" VerticalAlignment="Center">
                </TextBlock>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="{Binding StringFormat={}{0}, Path=NPC.Value.charType, RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center">
                </TextBlock>
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding StringFormat=CHAR NAME: {0}, Path=NPC.Value.CharNameGet, RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center">
                </TextBlock>
            </Grid>
            </Grid>
        </Button>
    </Grid>
</UserControl>
