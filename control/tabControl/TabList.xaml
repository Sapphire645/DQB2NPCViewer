<UserControl x:Class="DQB2NPCViewer.control.TabList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2NPCViewer.control"
             xmlns:control="clr-namespace:DQB2NPCViewer.control"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid>
    <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TabControl>
            <TabItem Header="Story Characters" FontWeight="Bold">
                <Grid Name="Story"/>
            </TabItem>
            <TabItem Header="Generic Characters" FontWeight="Bold">
                <Grid Name="Generic"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
