<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DQB2NPCViewer"
        xmlns:s="clr-namespace:DQB2NPCViewer.code"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:HelixToolkit="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:control="clr-namespace:DQB2NPCViewer.control"
        xmlns:Collections="clr-namespace:System.Collections;assembly=mscorlib" x:Class="DQB2NPCViewer.MainWindow"
        mc:Ignorable="d"
        Title="DQB2 NPC Viewer Alpha 1" WindowState ="Normal" MinWidth="1100" MinHeight="730" Icon="images/resource/icon.ico">
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="450*"/>
        </Grid.RowDefinitions>
        <ToolBar VerticalAlignment="Center">
            <Button Height="32" Width="32" Click="CMNDAT_Open_Click">
                <Image Source="/images/resource/open.png" />
            </Button>
            <Button Height="32" Width="32" Click="CMNDAT_Save_Click">
                <Image Source="/images/resource/save.png" />
            </Button>
            <Separator/>
            <Button Height="32" Width="32" Click="Open_Click">
                <Image Source="/images/resource/import.png" />
            </Button>
            <Button Height="32" Width="32" Click="Save_Click">
                <Image Source="/images/resource/export.png" />
            </Button>
            <Separator/>
            <Button Height="32" Click="Create_Click">
                <Image Source="/images/resource/create.png" />
            </Button>
            <Image x:Name="LoadingImage" Source="/images/resource/Loading.png" Height="24" MaxHeight="24" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="Saving" Source="/images/resource/Saving.png" Height="24" MaxHeight="24" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ToolBar>
        <TabControl Name="Tabs" Grid.Row="1" Margin="0,0,0,0" SelectionChanged="EditingTabChange">
            <TabItem Name="TabEditing" Header="NPC Editing" Height="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width ="360"/>
                        <ColumnDefinition Width ="2*"/>
                    </Grid.ColumnDefinitions>
                    <control:TabList x:Name="SelectionList"/>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height ="6*"/>
                            <RowDefinition Height ="150"/>
                        </Grid.RowDefinitions>
                        <TabControl Name="TabNPC" Margin="5,5,5,5">
                            <TabItem Name="TabEditingGeneral" Header="General">
                                <Grid Name="EditingGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width ="1*"/>
                                        <ColumnDefinition Width ="1*"/>
                                        <ColumnDefinition Width ="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical" Margin="5,5,5,5">
                                        <Button Content="Name" Click="InfoPanel_Click" Tag="0" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <TextBox Text="{Binding EditingNPC.Value.name}" Height="25" Padding="2,2,0,0"/>
                                        <Button Content="Sex" Click="InfoPanel_Click" Tag="1" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <UniformGrid Columns="2" Height="25">
                                            <ToggleButton Content="Male" IsChecked="{Binding EditingNPC.Value.isMale, Mode=TwoWay}" Click="test"/>
                                            <ToggleButton Content="Female" IsChecked="{Binding EditingNPC.Value.isFemale, Mode=TwoWay}" Click="test"/>
                                        </UniformGrid>
                                        <Button Content="HP" Click="InfoPanel_Click" Tag="2" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <TextBox Text="{Binding EditingNPC.Value.HP}" Height="25" Padding="2,2,0,0"/>
                                        <Button Content="Job" Click="InfoPanel_Click" Tag="3" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <ComboBox ItemsSource="{x:Static s:ListText.JobList}" Height="25" SelectedValuePath="Id" SelectedValue="{Binding EditingNPC.Value.job}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} - {1}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="Name" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Native Home" Click="InfoPanel_Click" Tag="5" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <ComboBox ItemsSource="{x:Static s:ListText.IslandList}" Height="25" SelectedValuePath="Id" SelectedValue="{Binding EditingNPC.Value.nativeHome}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} - {1}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="Name" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Current Island" Click="InfoPanel_Click" Tag="6" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <ComboBox ItemsSource="{x:Static s:ListText.IslandList}" Height="25" SelectedValuePath="Id" SelectedValue="{Binding EditingNPC.Value.island}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} - {1}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="Name" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Place" Click="InfoPanel_Click" Tag="7" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <ComboBox ItemsSource="{x:Static s:ListText.PlaceList}" Height="25" SelectedValuePath="Id" SelectedValue="{Binding EditingNPC.Value.place}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} - {1}">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="Name"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Voice" Click="InfoPanel_Click" Tag="8" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <TextBox Text="{Binding EditingNPC.Value.voice}" Height="25" Padding="2,2,0,0"/>
                                        <Button Content="Message type" Click="InfoPanel_Click" Tag="18" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <TextBox Text="{Binding EditingNPC.Value.messages}" Height="25" Padding="2,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Name="TabListToGo" Grid.Column="1" Orientation="Vertical" Margin="5,5,5,5">
                                        <Grid>
                                            <Button Content="Character Type" Click="InfoPanel_Click" Tag="4" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <TextBox Text="{Binding EditingNPC.Value.charType}" Margin="90,0,0,0" Padding="5,2,5,2" Background="{x:Null}" IsReadOnly="True" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="5,5,5,5">
                                        <Button Content="Room Size" Tag="20" Click="InfoPanel_Click" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <ComboBox ItemsSource="{x:Static s:ListText.RoomSizeList}" Height="25" SelectedValuePath="ID" SelectedValue="{Binding EditingNPC.Value.roomSize}"/>
                                        <Image Height="10" Source="{Binding EditingNPC.Value.imageSize}" Margin="0,5,0,5"/>
                                        <Button Content="Room Fanciness" Click="InfoPanel_Click" Tag="21" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <ComboBox ItemsSource="{x:Static s:ListText.RoomFancyList}" Height="25" SelectedValuePath="ID" SelectedValue="{Binding EditingNPC.Value.roomFancy}"/>
                                        <Image Height="10" Source="{Binding EditingNPC.Value.imageFancy}" Margin="0,5,0,5"/>
                                        <Button Content="Room Ambiance" Click="InfoPanel_Click" Tag="22" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <ComboBox ItemsSource="{x:Static s:ListText.AmbianceList}" Height="25" SelectedValuePath="ID" SelectedValue="{Binding EditingNPC.Value.roomAmbiance}"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Name="TabEditingModel" Header="Visual">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width ="3*"/>
                                        <ColumnDefinition Width ="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width ="4*"/>
                                            <ColumnDefinition Width ="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height ="30"/>
                                            <RowDefinition Height ="1*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5,5,5,5">
                                            <CheckBox IsChecked="{Binding EditingNPC.Value.typeLock}" VerticalAlignment="Center" PreviewMouseDown="VisualChangeCheck" Click="FullModelUpdate"/>
                                            <Button Content="CharType Appearance Lock" Margin="2,0,20,0" Click="InfoPanel_Click" Tag="9" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,1,5,1" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <CheckBox IsChecked="{Binding EditingNPC.Value.hasClothes}" VerticalAlignment="Center" PreviewMouseDown="VisualChangeCheck" Click="BodyModelUpdate"/>
                                            <Button Content="Has Clothes" Margin="2,0,20,0"  Click="InfoPanel_Click" Tag="9" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,1,5,1" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <CheckBox IsChecked="{Binding EditingNPC.Value.hasRags}" VerticalAlignment="Center" PreviewMouseDown="VisualChangeCheck" Click="BodyModelUpdate"/>
                                            <Button Content="In Rags" Margin="2,0,20,0"  Click="InfoPanel_Click" Tag="9" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,1,5,1" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5,5,5,5">
                                            <Button Content="Character type" Click="InfoPanel_Click" Tag="4" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <ComboBox Name="ComboBoxCharType" Height="25" ItemsSource="{x:Static s:ListText.TypeLockList}" SelectedValuePath="ID" SelectedValue="{Binding EditingNPC.Value.charType}" PreviewMouseDown="VisualChangeCheck" SelectionChanged="FullModelUpdate"/>
                                            <Button Content="Job" Click="InfoPanel_Click" Tag="19" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <ComboBox Name="ComboJob" ItemsSource="{x:Static s:ListText.JobList}" Height="25" SelectedValuePath="Id" SelectedValue="{Binding EditingNPC.Value.job}" PreviewMouseDown="VisualChangeCheck" SelectionChanged="FullModelUpdate">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} - {1}">
                                                                    <Binding Path="Id"/>
                                                                    <Binding Path="Name"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="Face Model" Click="InfoPanel_Click" Tag="10" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <ComboBox Height="35" ItemsSource="{x:Static s:ListText.FaceList}" SelectedValuePath="ModelClassV.ID" SelectedValue="{Binding EditingNPC.Value.faceModel}" PreviewMouseDown="VisualChangeCheck" SelectionChanged="FaceModelUpdate"/>
                                            <Button Content="Hair Model" Click="InfoPanel_Click" Tag="11" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <ComboBox Height="35" ItemsSource="{x:Static s:ListText.HairList}" SelectedValuePath="ModelClassV.ID" SelectedValue="{Binding EditingNPC.Value.hairModel}" PreviewMouseDown="VisualChangeCheck" SelectionChanged="HairModelUpdate"/>
                                            <Button Content="Body Model" Click="InfoPanel_Click" Tag="12" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <ComboBox Height="35" ItemsSource="{x:Static s:ListText.BodyList}" SelectedValuePath="ModelClassV.ID" SelectedValue="{Binding EditingNPC.Value.bodyModel}" PreviewMouseDown="VisualChangeCheck" SelectionChanged="BodyModelUpdate"/>
                                            <Button Content="Armour/Clothes" Click="InfoPanel_Click" Tag="17" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <ComboBox Name="ComboArmour" Height="35" ItemsSource="{x:Static s:ListText.ArmourList}" SelectedValuePath="Armour.ID" SelectedValue="{Binding EditingNPC.Value.armour}" PreviewMouseDown="VisualChangeCheck" SelectionChanged="BodyModelUpdate"/>
                                            <Button Content="Weapon" Click="InfoPanel_Click" Tag="16" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <ComboBox Height="35" ItemsSource="{x:Static s:ListText.WeaponList}" SelectedValuePath="ItemID" SelectedValue="{Binding EditingNPC.Value.weapon}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Margin="0,0,0,0" Grid.Column="0" Height="25" Source="{Binding Image}" />
                                                            <TextBlock Margin="0,0,0,0" Grid.Column="1" Width="Auto" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} - {1}">
                                                                        <Binding Path="ItemID" />
                                                                        <Binding Path="Name" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="5,5,5,5">
                                            <Button Content="Sex" Click="InfoPanel_Click" Tag="1" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <UniformGrid Columns="2" Height="25">
                                                <ToggleButton Content="Male" IsChecked="{Binding EditingNPC.Value.isMale, Mode=TwoWay}" Click="test"/>
                                                <ToggleButton Content="Female" IsChecked="{Binding EditingNPC.Value.isFemale, Mode=TwoWay}" Click="test"/>
                                            </UniformGrid>
                                            <Button Content="Size of Character" Click="InfoPanel_Click" Tag="19" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <TextBox Text="{Binding SelectedItem.StringSize, ElementName=ComboJob, Mode=OneWay}" Height="25" Padding="5,2,5,2" IsReadOnly="True" IsHitTestVisible="False"/>
                                            <Button Content="Eye Colour" Click="InfoPanel_Click" Tag="13" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <UniformGrid Columns="2" Height="35">
                                                <Button Content="{Binding EditingNPC.Value.eyeColour}" Click="ChangeColour" Tag="0"/>
                                                <Rectangle Stroke="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" Fill="{Binding EyeColour.Value}"/>
                                            </UniformGrid>
                                            <Button Content="Hair Colour" Click="InfoPanel_Click" Tag="14" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <UniformGrid Columns="2" Height="35">
                                                <Button Content="{Binding EditingNPC.Value.hairColour}" Click="ChangeColour" Tag="1"/>
                                                <Rectangle Stroke="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" Fill="{Binding HairColour.Value}"/>
                                            </UniformGrid>
                                            <Button Content="Skin Colour" Click="InfoPanel_Click" Tag="15" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <UniformGrid Columns="2" Height="35">
                                                <Button Content="{Binding EditingNPC.Value.skinColour}" Click="ChangeColour" Tag="2"/>
                                                <UniformGrid Columns="2" Height="35">
                                                    <Rectangle Stroke="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" Fill="{Binding SkinColour.Value}"/>
                                                    <Rectangle Stroke="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" Fill="{Binding SkinColourFilter.Value}"/>
                                                </UniformGrid>
                                            </UniformGrid>
                                            <Button Content="Clothes Colour" Click="InfoPanel_Click" Tag="17" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                            <Rectangle Height="35" Stroke="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" Fill="{Binding ClothColour.Value}"/>
                                        </StackPanel>
                                    </Grid>

                                    <HelixToolkit:HelixViewport3D x:Name="MyHelixViewport" Grid.Column="1" Background="DarkGray" Margin="3,3,3,3">
                                        <!-- Define a camera for viewing the model -->
                                        <HelixToolkit:HelixViewport3D.Camera>
                                            <PerspectiveCamera Position="1,0,0.8" LookDirection="-1,0,0" UpDirection="0,0,1" FieldOfView="45" />
                                        </HelixToolkit:HelixViewport3D.Camera>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <Model3DGroup>
                                                    <!-- Brighter SpotLight -->
                                                    <SpotLight Color="White" Position="5,5,5" Direction="-1,-1,-1" 
                                   InnerConeAngle="30" OuterConeAngle="60"/>
                                                    <!-- Add other lights or models here -->
                                                </Model3DGroup>
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>

                                        <!-- Add lighting to the scene -->
                                        <HelixToolkit:SunLight/>

                                        <!-- Placeholder for your imported 3D model -->
                                        <ModelVisual3D x:Name="ModelGroupVisualName">
                                            <!-- Content will be set in the code-behind -->
                                        </ModelVisual3D>
                                    </HelixToolkit:HelixViewport3D>
                                </Grid>
                            </TabItem>
                            <TabItem Name="TabEditingInventory" Header="Inventory"/>
                            <TabItem Name="TabEditingMap" Header="Map Coordinates">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" MinWidth="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical" Margin="5,5,5,5">
                                        <Button Content="X Coordinate" Click="InfoPanel_Click" Tag="0" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <TextBox Text="{Binding EditingNPC.Value.coordX}" Height="25" Padding="2,2,0,0"/>
                                        <Button Content="Y Coordinate" Click="InfoPanel_Click" Tag="0" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <TextBox Text="{Binding EditingNPC.Value.coordY}" Height="25" Padding="2,2,0,0"/>
                                        <Button Content="Z Coordinate" Click="InfoPanel_Click" Tag="0" ToolTipService.InitialShowDelay="50" ToolTip="Click for info!" Padding="5,2,5,2" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"/>
                                        <TextBox Text="{Binding EditingNPC.Value.coordZ}" Height="25" Padding="2,2,0,0"/>
                                    </StackPanel>
                                    <Viewbox Name="Map" Grid.Column="1">
                                        <Grid Width="512" Height="512">
                                            <Image Source="/images/maps/STGDAT01.png" />
                                            <Ellipse Fill="Orange" Stroke="Black" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding EditingNPC.Value.coordMargin}"/>
                                        </Grid>
                                    </Viewbox>
                                </Grid>

                            </TabItem>
                        </TabControl>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width ="330"/>
                                <ColumnDefinition Width ="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="5,5,5,5" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height ="32"/>
                                    <RowDefinition Height ="4*"/>
                                </Grid.RowDefinitions>
                                <Rectangle Stroke="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" Grid.RowSpan="2"/>
                                <UniformGrid Margin="5,5,5,5" Columns="2" Rows="1">
                                    <Button Content="Edit this slot" Height="22" Click="LoadSelectedNPC_Click"/>
                                    <Button Content="Save edited to this slot"  Height="22"  Click="SaveSelectedNPC_Click"/>
                                </UniformGrid>
                                <Grid Grid.Row="1" Margin="5,5,5,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width ="2*"/>
                                        <ColumnDefinition Width ="4*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Path=SelectedNPC.Value.NPC.Value.Image, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <StackPanel Grid.Column="2" Orientation="Vertical">
                                        <UniformGrid Grid.Row="0" Columns="2" Margin="0,4,0,4">
                                            <TextBlock Grid.Row="0" Text="{Binding StringFormat={}Offset: {0}, Path=SelectedNPC.Value.NPC.Value.offset, RelativeSource={RelativeSource AncestorType=Window},Mode=OneWay}" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Grid.Row="2" Text="{Binding StringFormat=Char Type: {0}, Path=SelectedNPC.Value.NPC.Value.charType, RelativeSource={RelativeSource AncestorType=Window},Mode=OneWay}" VerticalAlignment="Center" FontSize="13"/>
                                        </UniformGrid>
