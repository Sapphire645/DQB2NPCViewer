                                <StackPanel Orientation="Horizontal" >
                                    <TextBlock Text="Information: " Margin="5,6,0,0" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Path=NameDescText.Value, RelativeSource={RelativeSource AncestorType=Window},Mode=OneWay}" Margin="0,6,0,0" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="{Binding Path=DescText.Value, RelativeSource={RelativeSource AncestorType=Window},Mode=OneWay}" Margin="5,2,5,0" TextWrapping="WrapWithOverflow"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
